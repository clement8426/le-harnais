+      if (!String(error).includes("already in use")) throw error
+      for (let essai = 0; essai < 4; essai++) {
+        await new Promise((fini) => setTimeout(fini, 3000))
+        const trouve = await client.Service.discover({ version }).catch(() => undefined)
+        if (trouve) return trouve
+      }
+      const port = /port (\d+)/.exec(String(error))?.[1]
+      if (!port || !(await arreterServiceOublie(port))) throw error
+      return ensure()
+    })
+  const service = early ?? (yield* Effect.tryPromise(adopter))
 
   if (service.auth?.type !== "basic") throw new Error("V2 CLI background service did not provide authentication")
   const url = new URL(service.url)
@@ -91,6 +107,22 @@ const connect = Effect.fn("BackgroundService.connect")(function* (mode: "initial
   return ready
 })
 
+// Arrête le processus qui écoute sur ce port, seulement s'il vient du dossier de données du Harnais (jamais le service
+// d'un autre OpenCode). Renvoie vrai si un processus a été arrêté. Windows seulement pour l'instant.
+function arreterServiceOublie(port: string) {
+  if (process.platform !== "win32" || !/^\d+$/.test(port)) return Promise.resolve(false)
+  const dossier = app.getPath("userData").replaceAll("'", "''")
+  const commande = [
+    `$c = Get-NetTCPConnection -LocalPort ${port} -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1`,
+    `if ($c) { $p = Get-Process -Id $c.OwningProcess -ErrorAction SilentlyContinue; if ($p -and $p.Path -like '${dossier}\\*') { Stop-Process -Id $p.Id -Force; 'arrete' } }`,
+  ].join("; ")
+  return new Promise<boolean>((fini) =>
+    execFile("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", commande], { windowsHide: true, timeout: 15_000 }, (_erreur, sortie) =>
+      fini(String(sortie).includes("arrete")),
+    ),
+  )
+}
