diff --git a/packages/desktop/src/main/lifecycle/le-harnais.ts b/packages/desktop/src/main/lifecycle/le-harnais.ts
new file mode 100644
index 0000000..b308519
--- /dev/null
+++ b/packages/desktop/src/main/lifecycle/le-harnais.ts
@@ -0,0 +1,30 @@
+// Le Harnais, application publiée : ses propres dossiers de données (rien de partagé avec un OpenCode installé),
+// son plugin réinstallé à chaque démarrage (il suit la version de l'application), et les chemins de ses contenus
+// et de l'intégration du shell, lus par le plugin et par la création des terminaux (patch 04).
+// En développement, scripts/dev.ts du dépôt Le Harnais fait la même chose avec OPENCODE_DESKTOP_TEST_ROOT.
+
+import { copyFileSync, mkdirSync } from "node:fs"
+import path from "node:path"
+
+export function configurerLeHarnais(donnees: string) {
+  process.env.LE_HARNAIS_DONNEES = donnees
+  for (const [variable, dossier] of [
+    ["XDG_DATA_HOME", "data"],
+    ["XDG_CONFIG_HOME", "config"],
+    ["XDG_CACHE_HOME", "cache"],
+    ["XDG_STATE_HOME", "state"],
+  ] as const) {
+    process.env[variable] = path.join(donnees, dossier)
+    mkdirSync(process.env[variable]!, { recursive: true })
+  }
+
+  const ressources = path.join(process.resourcesPath, "le-harnais")
+  const plugins = path.join(process.env.XDG_CONFIG_HOME!, "opencode", "plugins")
+  mkdirSync(plugins, { recursive: true })
+  copyFileSync(path.join(ressources, "plugin", "le-harnais.js"), path.join(plugins, "le-harnais.js"))
+
+  process.env.LABO_CONTENUS ??= path.join(ressources, "contenus")
+  process.env.LE_HARNAIS_POWERSHELL_INIT ??= path.join(ressources, "shell", "integration.ps1")
+  // bash lit ce chemin dans PROMPT_COMMAND : barres obliques normales, que Git Bash comprend aussi.
+  process.env.LE_HARNAIS_BASH_INIT ??= path.join(ressources, "shell", "integration.sh").replaceAll("\\", "/")
+}
