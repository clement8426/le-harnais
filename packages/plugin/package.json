{
  "name": "@le-harnais/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Le plugin serveur du Harnais pour OpenCode V2 : droits de l'IA, journal, consignes du prof, RPC du panneau.",
  "main": "./src/index.ts",
